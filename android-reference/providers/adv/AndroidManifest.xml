<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.appfair.notary.adv"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />
    <application android:label="@string/app_name" android:icon="@drawable/ic_adv">
        <!-- Declares the notary; see shared/.../NotaryContract.java for the attributes. -->
        <meta-data android:name="org.appfair.notarization.PROVIDER" android:resource="@xml/notary" />
        <!-- Only the platform's package verifier may bind: the system enforces the permission,
             and NotaryService checks it again. -->
        <service
            android:name=".AdvNotaryService"
            android:exported="true"
            android:permission="android.permission.PACKAGE_VERIFICATION_AGENT">
            <intent-filter>
                <action android:name="org.appfair.notarization.NOTARY_SERVICE" />
            </intent-filter>
        </service>
    </application>
</manifest>

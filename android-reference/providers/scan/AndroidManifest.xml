<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.appfair.notary.scan"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />
    <!-- This provider has no service: it declares an HTTPS endpoint that the coordinator calls
         directly. An existing app only needs the metadata entry to offer a notary. -->
    <application android:label="@string/app_name" android:icon="@drawable/ic_scan">
        <meta-data android:name="org.appfair.notarization.PROVIDER" android:resource="@xml/notary" />
    </application>
</manifest>

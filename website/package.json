{
  "name": "community-notarization-website",
  "private": true,
  "type": "module",
  "scripts": {
    "resources": "node scripts/generate-resources.mjs",
    "dev": "npm run resources && astro dev --host 127.0.0.1",
    "build": "npm run resources && astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "npm run resources && node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "astro": "7.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
